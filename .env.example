# Скопировать в .env и подставить значения. .env в git не коммитится.

# HTTP
HTTP_ADDR=:8080
# Статический токен owner-only API (заголовок X-API-Token). Обязателен:
# с пустым токеном сервер не стартует. Сгенерировать: openssl rand -hex 32
API_TOKEN=change-me
# Работа без авторизации — только явно и только локально.
# API_AUTH_DISABLED=true

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meal_planner
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
# Альтернатива DB_*: единый DATABASE_URL (имеет приоритет, если задан)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/meal_planner?sslmode=disable
# URL для opt-in integration-тестов. Тесты создают и удаляют отдельную schema,
# но используйте выделенную тестовую БД, а не development database.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/meal_planner_test?sslmode=disable

# LLM
# LLM_PROVIDER: anthropic | openai. Модель должна принадлежать провайдеру.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# LLM_ENDPOINT необязателен: пустой означает штатный url провайдера
# (/v1/messages для anthropic, /v1/chat/completions для openai). Задавайте
# только для прокси или OpenAI-совместимого шлюза.
# LLM_ENDPOINT=
LLM_API_KEY=

# Кухонная техника, доступная планировщику (через запятую).
# Рецепты, требующие другого оборудования, отсеиваются до поиска.
PLANNER_EQUIPMENT=stove,oven
