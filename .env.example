# Скопировать в .env и подставить значения. .env в git не коммитится.

# HTTP
HTTP_ADDR=:8080
# Статический токен owner-only API (заголовок X-API-Token). Пусто = без авторизации.
API_TOKEN=change-me

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meal_planner
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
# Альтернатива DB_*: единый DATABASE_URL (имеет приоритет, если задан)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/meal_planner?sslmode=disable

# LLM
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
